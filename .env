# UtahMeta - Media Sandbox environment config
# Copy this file to .env and adjust for your setup.

# ---------- Server ----------
PORT=4100
NODE_ENV=development

# ---------- Postgres (durable relational store) ----------
# For local dev this points at the docker-compose Postgres service.
DATABASE_URL=postgresql://utahmeta:utahmeta_dev_password@localhost:5432/utahmeta
# Change this from the default before running anything beyond localhost.
POSTGRES_PASSWORD=utahmeta_dev_password

# ---------- Redis (live session store + pub/sub) ----------
REDIS_URL=redis://localhost:6379

# ---------- Media ----------
# Absolute path to your real media library on the host. In Docker this is
# mounted read-only at MEDIA_MOUNT_PATH inside the container.
MEDIA_LIBRARY_PATH=./media
# Path the app scans/streams from. In Docker this is the in-container mount
# point (/media); for local dev set it to MEDIA_LIBRARY_PATH.
MEDIA_MOUNT_PATH=/media

# ---------- Metadata & artwork (optional — Phase 4) ----------
# A TMDB v3 API key from https://www.themoviedb.org/settings/api. When set,
# library scans enrich movies with canonical titles/years/runtime and
# download poster + backdrop artwork. Leave blank to index from filenames
# only (no network calls, no artwork).
TMDB_API_KEY=679d218e8f513b03475ae77b69da87e3
# Where downloaded posters/backdrops are written.
ARTWORK_PATH=./artwork
PREPARED_MEDIA_PATH=./prepared
