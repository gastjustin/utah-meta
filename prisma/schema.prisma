// UtahMeta - Durable relational schema
// Covers ERD sections: 1) Content Library, 2) Metadata & Discovery,
// 3) Users & Playback (structural tables only — live sessions/events
// live in Redis, see src/session-store.ts), 4) Preparation & Compatibility
// (durable job history), 5) Edge Cache & Home Node (durable audit trail —
// hot cache state itself lives in Redis), 6) Platform & Operations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- 1) Content Library ----------

model Library {
  libraryId  String   @id @default(uuid()) @map("library_id")
  name       String
  kind       String // "movies" | "tv" | "music" etc.
  rootPath   String   @map("root_path")
  scanPolicy String?  @map("scan_policy")

  series     Series[]
  mediaItems MediaItem[]
  scanJobs   ScanJob[]

  @@map("library")
}

model Series {
  seriesId  String  @id @default(uuid()) @map("series_id")
  libraryId String  @map("library_id")
  title     String
  sortTitle String? @map("sort_title")
  status    String?
  // Metadata enrichment (Phase 4). Populated from TMDB when TMDB_API_KEY
  // is set; tmdbId doubles as the "already enriched" marker so we only
  // look a series up once across a scan.
  tmdbId       String? @map("tmdb_id")
  firstAirYear Int?    @map("first_air_year")
  posterUri    String? @map("poster_uri")
  backdropUri  String? @map("backdrop_uri")

  library Library  @relation(fields: [libraryId], references: [libraryId])
  seasons Season[]

  @@unique([libraryId, title])
  @@map("series")
}

model Season {
  seasonId     String  @id @default(uuid()) @map("season_id")
  seriesId     String  @map("series_id")
  seasonNumber Int     @map("season_number")
  title        String?

  series     Series      @relation(fields: [seriesId], references: [seriesId])
  mediaItems MediaItem[]

  @@unique([seriesId, seasonNumber])
  @@map("season")
}

model MediaItem {
  mediaItemId       String   @id @default(uuid()) @map("media_item_id")
  libraryId         String   @map("library_id")
  seasonId          String?  @map("season_id")
  itemType          String   @map("item_type") // "movie" | "episode" | "track"
  title             String
  episodeNumber     Int?     @map("episode_number") // ordering within a season; not in original ERD
  runtimeMs         Int?     @map("runtime_ms")
  releaseYear       Int?     @map("release_year")
  overview          String?  @map("overview")
  canonicalMetadataId String? @map("canonical_metadata_id")

  library      Library        @relation(fields: [libraryId], references: [libraryId])
  season       Season?        @relation(fields: [seasonId], references: [seasonId])
  artworkAssets ArtworkAsset[]
  mediaCredits  MediaCredit[]
  mediaGenres   MediaGenre[]
  fileAssets    FileAsset[]
  versionVariants VersionVariant[]
  collectionItems CollectionItem[]
  watchStates   WatchState[]
  preparationJobs PreparationJob[]

  @@index([libraryId])
  @@map("media_item")
}

model ArtworkAsset {
  artworkAssetId String @id @default(uuid()) @map("artwork_asset_id")
  mediaItemId    String @map("media_item_id")
  kind           String // "poster" | "backdrop" | "logo"
  storageUri     String @map("storage_uri")
  checksum       String?

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [mediaItemId])

  @@map("artwork_asset")
}

model ExternalIdMap {
  externalIdId String @id @default(uuid()) @map("external_id_id")
  mediaItemId  String @map("media_item_id")
  provider     String // "tmdb" | "tvdb" | "musicbrainz"
  externalKey  String @map("external_key")

  @@unique([provider, externalKey])
  @@map("external_id_map")
}

model FileAsset {
  fileAssetId      String  @id @default(uuid()) @map("file_asset_id")
  mediaItemId      String  @map("media_item_id")
  storageVolumeId  String  @map("storage_volume_id")
  sourcePath       String  @unique @map("source_path") // absolute path on disk, matches PlaybackSession.mediaPath
  container        String
  videoCodec       String  @map("video_codec")
  audioCodec       String  @map("audio_codec")
  sizeBytes        BigInt  @map("size_bytes")
  // Last-modified timestamp of the file on disk at scan time. Lets the
  // scanner do incremental rescans: skip files whose mtime + size are
  // unchanged, re-probe only the ones that actually changed.
  modifiedAt       DateTime? @map("modified_at")

  mediaItem      MediaItem       @relation(fields: [mediaItemId], references: [mediaItemId])
  storageVolume  StorageVolume   @relation(fields: [storageVolumeId], references: [storageVolumeId])
  versionVariants VersionVariant[]

  @@map("file_asset")
}

model VersionVariant {
  variantId            String  @id @default(uuid()) @map("variant_id")
  mediaItemId          String  @map("media_item_id")
  sourceFileAssetId    String  @map("source_file_asset_id")
  compatibilityProfileId String? @map("compatibility_profile_id")
  storageUri           String? @map("storage_uri") // prepared output file path
  storageVolumeId      String? @map("storage_volume_id")
  directPlayReady      Boolean @default(false) @map("direct_play_ready")
  prepState            String  @map("prep_state") // "pending" | "ready" | "failed"

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [mediaItemId])
  sourceFileAsset FileAsset @relation(fields: [sourceFileAssetId], references: [fileAssetId])
  compatibilityProfile CompatibilityProfile? @relation(fields: [compatibilityProfileId], references: [compatibilityProfileId])
  outputStorageVolume StorageVolume? @relation(fields: [storageVolumeId], references: [storageVolumeId], name: "variant_outputs")
  preparationJobs PreparationJob[]

  @@map("version_variant")
}

model StorageVolume {
  storageVolumeId String  @id @default(uuid()) @map("storage_volume_id")
  name            String
  tier            String // "hot" | "archive"
  rootPath        String  @map("root_path")
  capacityBytes   BigInt  @map("capacity_bytes")
  rebuildable     Boolean @default(false)

  fileAssets FileAsset[]
  variantOutputs VersionVariant[] @relation(name: "variant_outputs")

  @@map("storage_volume")
}

// ---------- 2) Metadata & Discovery ----------

model Person {
  personId   String @id @default(uuid()) @map("person_id")
  name       String
  personType String @map("person_type") // "actor" | "director" | "composer"
  photoPath  String? @map("photo_path") // local filesystem path to a downloaded TMDB headshot

  credits MediaCredit[]

  @@map("person")
}

model MediaCredit {
  mediaCreditId String  @id @default(uuid()) @map("media_credit_id")
  mediaItemId   String  @map("media_item_id")
  personId      String  @map("person_id")
  creditRole    String  @map("credit_role")
  billingOrder  Int?    @map("billing_order")

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [mediaItemId])
  person    Person    @relation(fields: [personId], references: [personId])

  @@map("media_credit")
}

model Genre {
  genreId String @id @default(uuid()) @map("genre_id")
  name    String @unique

  mediaGenres MediaGenre[]

  @@map("genre")
}

model MediaGenre {
  mediaGenreId String @id @default(uuid()) @map("media_genre_id")
  mediaItemId  String @map("media_item_id")
  genreId      String @map("genre_id")

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [mediaItemId])
  genre     Genre     @relation(fields: [genreId], references: [genreId])

  @@unique([mediaItemId, genreId])
  @@map("media_genre")
}

model Collection {
  collectionId   String @id @default(uuid()) @map("collection_id")
  name           String
  collectionType String @map("collection_type") // "franchise" | "playlist"

  items CollectionItem[]

  @@map("collection")
}

model CollectionItem {
  collectionItemId String @id @default(uuid()) @map("collection_item_id")
  collectionId     String @map("collection_id")
  mediaItemId      String @map("media_item_id")
  sortOrder        Int    @map("sort_order")

  collection Collection @relation(fields: [collectionId], references: [collectionId])
  mediaItem  MediaItem  @relation(fields: [mediaItemId], references: [mediaItemId])

  @@map("collection_item")
}

// ---------- 3) Users & Playback (structural — durable) ----------
// Live PlaybackSession / PlaybackEvent are NOT here — they're high-churn
// and ephemeral, so they live in Redis (src/session-store.ts). WatchState
// is the durable "resume point" record, written on session end/pause.

model UserProfile {
  userId            String  @id @default(uuid()) @map("user_id")
  displayName        String  @map("display_name")
  authSubject         String  @unique @map("auth_subject")
  passwordHash       String? @map("password_hash")
  isAdmin             Boolean @default(false) @map("is_admin")
  defaultAudioPolicyId String? @map("default_audio_policy_id")
  homeNodeId          String? @map("home_node_id")

  devices    DeviceProfile[]
  watchStates WatchState[]

  @@map("user_profile")
}

model DeviceProfile {
  deviceId       String  @id @default(uuid()) @map("device_id")
  userId         String  @map("user_id")
  deviceName     String  @map("device_name")
  clientType     String  @map("client_type") // matches CLIENT_CAPABILITIES key
  capabilityHash String? @map("capability_hash")
  maxBitrate     Int?    @map("max_bitrate")
  lastSeenAt     DateTime? @map("last_seen_at")

  user        UserProfile  @relation(fields: [userId], references: [userId])

  @@map("device_profile")
}

model WatchState {
  watchStateId String   @id @default(uuid()) @map("watch_state_id")
  userId       String   @map("user_id")
  mediaItemId  String   @map("media_item_id")
  positionMs   Int      @map("position_ms")
  completed    Boolean  @default(false)
  rating       Int?     @map("rating")
  lastWatchedAt DateTime @map("last_watched_at")

  user      UserProfile @relation(fields: [userId], references: [userId])
  mediaItem MediaItem   @relation(fields: [mediaItemId], references: [mediaItemId])

  @@unique([userId, mediaItemId])
  @@map("watch_state")
}

// ---------- 4) Preparation & Compatibility ----------

model CompatibilityProfile {
  compatibilityProfileId String @id @default(uuid()) @map("compatibility_profile_id")
  name           String @unique
  container      String
  videoCodec     String  @map("video_codec")
  audioCodec     String  @map("audio_codec")
  maxResolution  String  @map("max_resolution")

  versionVariants VersionVariant[]
  preparationJobs PreparationJob[]

  @@map("compatibility_profile")
}

model AudioPolicy {
  audioPolicyId String  @id @default(uuid()) @map("audio_policy_id")
  name          String
  englishOnly   Boolean @default(false) @map("english_only")
  normalizeAudio Boolean @default(true) @map("normalize_audio")

  @@map("audio_policy")
}

// Durable record of prep jobs. Queue/in-progress state for these is
// mirrored in Redis for fast polling; this table is the audit trail.
model PreparationJob {
  prepJobId              String   @id @default(uuid()) @map("prep_job_id")
  mediaItemId             String   @map("media_item_id")
  sourceFileAssetId        String   @map("source_file_asset_id")
  compatibilityProfileId   String   @map("compatibility_profile_id")
  outputVariantId          String?  @map("output_variant_id")
  status                   String // "queued" | "running" | "done" | "failed"
  queuedAt                 DateTime @default(now()) @map("queued_at")

  mediaItem MediaItem @relation(fields: [mediaItemId], references: [mediaItemId])
  compatibilityProfile CompatibilityProfile @relation(fields: [compatibilityProfileId], references: [compatibilityProfileId])
  outputVariant VersionVariant? @relation(fields: [outputVariantId], references: [variantId])

  @@map("preparation_job")
}

model ScanJob {
  scanJobId String   @id @default(uuid()) @map("scan_job_id")
  libraryId String   @map("library_id")
  scanType  String   @map("scan_type") // "full" | "incremental"
  status    String
  startedAt DateTime @default(now()) @map("started_at")

  library Library @relation(fields: [libraryId], references: [libraryId])

  @@map("scan_job")
}

// ---------- 5) Edge Cache & Home Node (durable audit trail) ----------
// Actual hot cache state (what's cached right now, TTLs) lives in Redis.
// These tables are the historical record: what got predicted, what got
// cached, and on what node — useful for tuning the prediction model later.

model HomeNode {
  homeNodeId    String   @id @default(uuid()) @map("home_node_id")
  name          String
  hardwareClass String   @map("hardware_class")
  cachePath     String   @map("cache_path")
  encryptionKeyHex String? @map("encryption_key_hex")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")

  @@map("home_node")
}

model PredictionEvent {
  predictionId       String   @id @default(uuid()) @map("prediction_id")
  userId             String   @map("user_id")
  currentMediaItemId String   @map("current_media_item_id")
  predictedMediaItemId String @map("predicted_media_item_id")
  confidence         Float
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("prediction_event")
}

// ---------- 6) Platform & Operations ----------

model HealthSnapshot {
  snapshotId  String   @id @default(uuid()) @map("snapshot_id")
  serviceName String   @map("service_name")
  nodeRef     String?  @map("node_ref")
  status      String
  measuredAt  DateTime @default(now()) @map("measured_at")

  @@map("health_snapshot")
}


